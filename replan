#!/usr/bin/env ruby

require 'English'
require 'io/console'
require 'shellwords'
require 'tempfile'

require_relative "#{File.basename(__FILE__)}.lib/replan_helper"
require_relative "#{File.basename(__FILE__)}.lib/archive_reader"

require_relative "#{File.basename(__FILE__)}.lib/relister"
require_relative "#{File.basename(__FILE__)}.lib/refixer"
require_relative "#{File.basename(__FILE__)}.lib/readder"
require_relative "#{File.basename(__FILE__)}.lib/cleaner"
require_relative "#{File.basename(__FILE__)}.lib/replanner"
require_relative "#{File.basename(__FILE__)}.lib/resnapper"
require_relative "#{File.basename(__FILE__)}.lib/retemplater"
require_relative "#{File.basename(__FILE__)}.lib/reworker"
require_relative "#{File.basename(__FILE__)}.lib/remover"

# Merge program is used on update.
MERGE_PROGRAM = ENV["SCRIPTING_MERGE_PROGRAM"]
TEMPLATE = ENV["TEMPLATE"]

def to_i(bool)
  bool ? 1 : 0
end

def conditional_save(content, original_content, schedule_filename, archive_filename, compare: false, archive_current_day:)
  if content != original_content
    if compare
      merge_program = MERGE_PROGRAM || raise("$SCRIPTING_MERGE_PROGRAM is required when saving with compare")

      updated_file = Tempfile.new('new').path
      IO.write updated_file, content
      `#{merge_program} #{schedule_filename.shellescape} #{updated_file.shellescape}`

      puts "Press `y` to commit the changes!"
      confirm_commit = $stdin.getch
    else
      confirm_commit = "y"
    end

    if confirm_commit == "y"
      if archive_current_day
        Remover.new.execute(schedule_filename, archive_filename, content)
      else
        IO.write(schedule_filename, content)
      end
    else
      puts "", "Changes not committed!"
    end
  else
    puts "No changes!"
  end
end

class Replan
  include ReplanHelper

  def apply_template(schedule_filename, template_filename:, day:, compare:)
    raise "template_filename is required in day mode" if !template_filename

    original_content = IO.read(schedule_filename)
    content = ensure_trailing_blank_line(original_content)
    content = Cleaner.new.execute(content)
    if !find_date_section(content, day, allow_not_found: true)
      preceding_date = find_preceding_or_existing_date(content, day)
      content = add_new_date_section(content, preceding_date, day)
    end
    day_templates(template_filename).each do |filename|
      content = Retemplater.new(filename).execute(content, date: day)
    end

    conditional_save(content, original_content, schedule_filename, nil, compare:, archive_current_day: false)
  end

  def list(schedule_filename, archive_filename, event_symbols, export: nil)
    archive_contents = ArchiveReader.new(archive_filename).read(export_start: export)
    content = (archive_contents + [IO.read(schedule_filename)]).join("\n")

    content = Cleaner.new.execute(content)
    Relister.new(event_symbols).execute(content, export:)
  end

  def update(schedule_filename, archive_filename, template_filename:, templates_directory: nil, compare:, skips_only:, debug:, no_template: false)
    content = IO.read(schedule_filename)

    # The last section must be terminated by a blank line (find_date_section requires it); editors can
    # trim the trailing blank line on save, so restore it before processing.
    content = ensure_trailing_blank_line(content)

    original_content = content.dup

    content = Cleaner.new.execute(content)
    content = Refixer.new.execute(content)
    content = Readder.new.execute(content)

    if !skips_only
      if !no_template
        day_templates(template_filename, templates_directory).each do |filename|
          content = Retemplater.new(filename).execute(content)
        end
      end

      content = Reworker.new.execute(content)

      if Resnapper.snap_reference?(content)
        templates_directory ||= File.dirname(template_filenames(template_filename).first) if template_filename
        raise "A templates directory is required to expand template references" unless templates_directory

        resnapper = Resnapper.new(templates_directory)
        content = resnapper.execute(content)
      end
    end

    replanner = Replanner.new
    content = replanner.execute(content, debug:, skips_only:)

    if resnapper
      current_section = find_date_section(content, find_first_date(content))
      # Replanner has consumed the current replan rules and kept the future references.
      expanded_section = resnapper.execute(current_section)
      if expanded_section != current_section
        content = content.sub(current_section) { expanded_section }
        content = replanner.execute(content, debug:) if expanded_section.include?('(replan')
      end
    end

    conditional_save(content, original_content, schedule_filename, archive_filename, compare:, archive_current_day: !skips_only)
  end

  private

  # The template may be a comma-separated list of filenames.
  #
  def template_filenames(template_filename)
    template_filename.to_s.split(',')
  end

  # The selected templates, followed by __daily.txt.
  #
  def day_templates(template_filename, templates_directory = nil)
    filenames = template_filenames(template_filename)

    templates_directory ||= File.dirname(filenames.first) if filenames.any?
    raise "A templates directory is required to apply __daily.txt" unless templates_directory

    (filenames + [File.join(templates_directory, '__daily.txt')]).uniq { |filename| File.expand_path(filename) }
  end
end

if __FILE__ == $PROGRAM_NAME
  require 'simple_scripting/argv'

  options = SimpleScripting::Argv.decode(
    [ "-D", "--debug",         "Debug mode" ],
    [ "-c", "--compare",       "Compare before replacing the file, if there is any change, and ask confirmation" ],
    [ "-d", "--day DAY",       "Apply templates and __daily.txt to DAY (YYYY-MM-DD)" ],
    [ "-t", "--no-template",   "Process the current day without applying next-day templates" ],
    [ "-l", "--list",          "List mode (limited to #{Relister::DEFAULT_DAYS_LISTED} days)"],
    [ "-x", "--export START",  "Export mode: list with JSON output and no limits; start: YYYY-MM-DD"],
    [ "-s", "--skips-only",    "Only move skips/once-offs"],
    [ "-w", "--work",          "Compute the work hours for the current day"],
  ) || exit

  require 'simple_scripting/configuration'

  configuration = SimpleScripting::Configuration.load
  schedule_filename = configuration.schedule_filename.full_path
  event_symbols = configuration.event_symbols

  export = options[:export]
  list = !!options[:list]
  work = !!options[:work]
  day = options[:day]
  debug = options.delete(:debug)

  if to_i(export) + to_i(work) + to_i(list) > 1
    raise "Only one of work/export/list modes is allowed"
  end

  begin
    if day
      raise "Day mode is only compatible with compare and debug options" if (options.keys - [:day, :compare]).any?
      raise "Invalid day: #{day.inspect}; expected YYYY-MM-DD" if !day.match?(/\A\d{4}-\d{2}-\d{2}\z/)

      template_filename = TEMPLATE || configuration.template_filename&.full_path
      compare = !!options[:compare]

      Replan.new.apply_template(schedule_filename, template_filename:, day: Date.iso8601(day), compare:)
    elsif !!export
      raise "Export mode is not compatible with other options" if options.size > 1

      archive_filename = configuration.archive_filename.full_path
      Replan.new.list(schedule_filename, archive_filename, event_symbols, export: Date.parse(export, '%F'))
    elsif list
      raise "List mode is not compatible with other options" if options.size > 1

      archive_filename = configuration.archive_filename.full_path

      Replan.new.list(schedule_filename, archive_filename, event_symbols)
    else
      if work
        raise "Work mode is not compatible with no-template" if options.key?(:no_template)

        content = Cleaner.new.execute(IO.read(schedule_filename))
        work_hours = Reworker.new.compute_first_date_work_hours(content)
        puts "Work hours: #{work_hours}"
      else
        archive_filename = configuration.archive_filename.full_path
        configured_template = configuration.template_filename&.full_path
        template_filename = TEMPLATE || configured_template
        templates_directory = File.dirname(configured_template) if configured_template
        skips_only = !!options[:skips_only]
        compare = !!options[:compare]

        Replan.new.update(schedule_filename, archive_filename, template_filename:, templates_directory:, compare:, skips_only:, debug:, no_template: options.key?(:no_template))
      end
    end
  rescue => error
    if debug
      raise error
    else
      warn "ERROR: #{error}"
      warn "Repair the file, then press Enter to retry (Ctrl+C to cancel)."
      exit 1 if !$stdin.gets

      retry
    end
  end
end
